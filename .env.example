# ==========================================
# CONFIGURAÇÕES GERAIS E MODO DE TESTE
# ==========================================
# MODO_TESTE: Se 'true', executa com navegador visível (headless=False) e pausas para acompanhamento humano
MODO_TESTE=true

# Quantidade máxima de notas a processar por ciclo no modo teste (evita disparos em massa)
LIMITE_NOTAS_POR_EXECUCAO=1

# Intervalo em segundos entre verificações de novas mensagens no WhatsApp
INTERVALO_MONITORAMENTO_SEGUNDOS=10

# ==========================================
# CONFIGURAÇÕES DO WHATSAPP WEB
# ==========================================
# Nome exato do contato ou grupo de onde chegam as notas (opcional; se vazio, monitora a conversa aberta ativa)
WHATSAPP_CHAT_ALVO=

# ==========================================
# CONFIGURAÇÕES DO ERP WEB
# ==========================================
ERP_URL=https://exemplo-erp.com.br/login
ERP_USUARIO=seu_usuario_aqui
ERP_SENHA=sua_senha_aqui

# ==========================================
# ATUALIZAÇÃO AUTOMÁTICA (GITHUB)
# ==========================================
# Repositório no formato usuario/repositorio
GITHUB_REPO=prethon/LancadorNotasTrier
